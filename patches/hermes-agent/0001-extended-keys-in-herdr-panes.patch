+        or term_program in {"iTerm.app", "WezTerm", "ghostty", "vscode", "herdr"}
         or env.get("KITTY_WINDOW_ID") or "kitty" in term
         or term == "xterm-ghostty"
         or term.startswith("tmux") or term_program.lower() == "tmux"
