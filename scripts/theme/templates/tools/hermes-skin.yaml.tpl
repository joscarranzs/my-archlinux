# Generated by scripts/theme/apply-theme.py from theme/colors.json — do not edit.
# Hermes skin (CLI + TUI + desktop). Every value is a theme role, so the agent's
# chrome follows the same palette as the rest of the desktop instead of keeping
# a hand-written copy that drifts on the next palette change.
#
# Roles that Hermes paints as *text* take the re-pitched `signal`/`text` values,
# not the raw ANSI ones: fills meant as backgrounds behind dark ink miss their
# contrast target when painted as text on `surface.base`.
name: {{palette.name}}
description: "Desktop palette — {{palette.name}}"

colors:
  # Base surface — the TUI/GUI derives its background from this.
  background: "{{surface.base}}"

  # Brand accent — headings, chevrons, focus rings, tool markers.
  ui_accent: "{{accent.primary}}"
  banner_accent: "{{accent.primary}}"

  # Text hierarchy: primary, body, label, muted.
  banner_title: "{{text.inkBright}}"
  banner_text: "{{text.ink}}"
  ui_label: "{{text.inkSoft}}"
  # Muted slot: inkFaint is tuned for comment/decoration duty, so body-adjacent
  # secondary text takes inkMuted.
  banner_dim: "{{text.inkMuted}}"

  # Borders, rules, gutters.
  banner_border: "{{surface.border}}"

  # Semantic status.
  ui_ok: "{{signal.green}}"
  ui_warn: "{{signal.yellow}}"
  ui_error: "{{signal.red}}"

  # CLI / TUI chrome.
  prompt: "{{text.ink}}"
  input_rule: "{{accent.primary}}"
  response_border: "{{accent.primary}}"
  status_bar_bg: "{{surface.raised}}"
  status_bar_text: "{{text.inkSoft}}"
  status_bar_strong: "{{text.inkBright}}"
  status_bar_dim: "{{text.inkMuted}}"
  status_bar_good: "{{signal.green}}"
  status_bar_warn: "{{signal.yellow}}"
  status_bar_bad: "{{signal.orange}}"
  status_bar_critical: "{{signal.red}}"
  # Session label is read as text, so it takes the bright accent ink.
  session_label: "{{accent.primaryInk}}"
  session_border: "{{surface.border}}"
  completion_menu_bg: "{{surface.raised}}"
  completion_menu_current_bg: "{{surface.line}}"
  completion_menu_meta_bg: "{{surface.raisedHigh}}"
  completion_menu_meta_current_bg: "{{surface.selection}}"
  selection_bg: "{{surface.selection}}"
  shell_dollar: "{{accent.neutral}}"
  voice_status_bg: "{{surface.raised}}"

branding:
  agent_name: Hermes Agent
  prompt_symbol: "❯"
  help_header: "(^_^)? Commands"

tool_prefix: "┊"
