/* Generated from theme/colors.json by scripts/theme/apply-theme.py — do not edit.
 *
 * libadwaita and GTK4 read their colours from these named colours, so
 * redefining them puts a GTK4 app on this palette while every widget keeps
 * Adwaita's geometry and behaviour.
 *
 * Only colours are defined here: a rule re-drawing a widget's internals is what
 * breaks a GTK app on the next release.
 */
@define-color accent_color {{accent.primaryInk}};
@define-color accent_bg_color {{accent.primary}};
@define-color accent_fg_color {{onAccent.primary}};
@define-color window_bg_color {{surface.base}};
@define-color window_fg_color {{text.ink}};
@define-color view_bg_color {{surface.raised}};
@define-color view_fg_color {{text.ink}};
@define-color headerbar_bg_color {{surface.raised}};
@define-color headerbar_fg_color {{text.ink}};
@define-color headerbar_border_color {{surface.line}};
@define-color headerbar_backdrop_color {{surface.base}};
@define-color headerbar_shade_color {{surface.line}};
@define-color sidebar_bg_color {{surface.base}};
@define-color sidebar_fg_color {{text.ink}};
@define-color sidebar_backdrop_color {{surface.base}};
@define-color sidebar_shade_color {{surface.line}};
@define-color secondary_sidebar_bg_color {{surface.base}};
@define-color secondary_sidebar_fg_color {{text.ink}};
@define-color secondary_sidebar_backdrop_color {{surface.base}};
@define-color secondary_sidebar_shade_color {{surface.line}};
@define-color card_bg_color {{surface.raisedHigh}};
@define-color card_fg_color {{text.ink}};
@define-color card_shade_color {{surface.line}};
@define-color dialog_bg_color {{surface.raised}};
@define-color dialog_fg_color {{text.ink}};
@define-color popover_bg_color {{surface.raised}};
@define-color popover_fg_color {{text.ink}};
@define-color thumbnail_bg_color {{surface.raisedHigh}};
@define-color thumbnail_fg_color {{text.ink}};
@define-color success_color {{signal.green}};
@define-color warning_color {{signal.yellow}};
@define-color error_color {{signal.red}};
@define-color destructive_color {{signal.red}};
@define-color success_bg_color {{signal.green}};
@define-color success_fg_color {{onAccent.signal}};
@define-color warning_bg_color {{signal.yellow}};
@define-color warning_fg_color {{onAccent.signal}};
@define-color error_bg_color {{signal.red}};
@define-color error_fg_color {{onAccent.signal}};
@define-color destructive_bg_color {{signal.red}};
@define-color destructive_fg_color {{onAccent.signal}};
