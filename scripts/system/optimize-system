#!/usr/bin/env bash
set -euo pipefail

echo "==> Applying low-risk system optimizations"

echo "==> Setting vm.swappiness=100 for zram"
echo 'vm.swappiness=100' | sudo tee /etc/sysctl.d/99-swappiness.conf >/dev/null
sudo sysctl --system >/dev/null

echo "==> Installing helper packages (pacman-contrib, python-gobject)"
sudo pacman -S --needed --noconfirm pacman-contrib python-gobject

echo "==> Cleaning pacman cache (keep 2 versions)"
sudo paccache -rk2 || true

echo "==> Done"
echo "Verify with:"
echo "  cat /proc/sys/vm/swappiness"
echo "  /usr/bin/python3 /usr/bin/powerprofilesctl get"