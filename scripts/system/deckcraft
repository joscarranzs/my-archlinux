#!/bin/sh
# Wrapper for DeckCraft — force X11 scale 1.5 for Hyprland 1.5 monitor scale.
# winit (egui) runs as XWayland (xwayland:1); WINIT_X11_SCALE_FACTOR makes it
# render at 1.5 natively so text stays sharp instead of compositor-upscaled blur.
# Keep hl.config xwayland.force_zero_scaling=true for sharpness.
export WINIT_X11_SCALE_FACTOR=1.5
exec /usr/bin/deckcraft "$@"
